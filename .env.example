# ==============================================================================
# SEOnaut Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust the values for your deployment.
# Variables with the SEONAUT_ prefix map directly to the application config:
#   database.server   -> SEONAUT_DATABASE_SERVER
#   database.port     -> SEONAUT_DATABASE_PORT
#   database.user     -> SEONAUT_DATABASE_USER
#   database.password -> SEONAUT_DATABASE_PASSWORD
#   database.database -> SEONAUT_DATABASE_DATABASE
# ==============================================================================

# ------------------------------------------------------------------------------
# MySQL Database Configuration
# ------------------------------------------------------------------------------
# MySQL server host (e.g., 127.0.0.1, localhost, or 'db' if using Docker)
SEONAUT_DATABASE_SERVER=127.0.0.1

# MySQL server port (default: 3306)
SEONAUT_DATABASE_PORT=3306

# MySQL database user
SEONAUT_DATABASE_USER=seonaut

# MySQL user password
SEONAUT_DATABASE_PASSWORD=your_mysql_password_here

# MySQL database name
SEONAUT_DATABASE_DATABASE=seonaut

# Standard MySQL environment variables (used by docker-compose and official MySQL images)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=seonaut
MYSQL_USER=seonaut
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here

# ------------------------------------------------------------------------------
# Application Server Configuration
# ------------------------------------------------------------------------------
# Server listening address (default: 0.0.0.0)
SEONAUT_SERVER_HOST=0.0.0.0

# Server listening port (PORT env var is also supported for Cloud Run / container platforms)
PORT=3000
SEONAUT_SERVER_PORT=3000

# Public base URL of the application
SEONAUT_SERVER_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Crawler Configuration
# ------------------------------------------------------------------------------
# User-Agent string sent during crawling
SEONAUT_CRAWLER_AGENT=Mozilla/5.0 (compatible; SEOnautBot/1.0; +https://seonaut.org/bot)

# ------------------------------------------------------------------------------
# UI Preferences
# ------------------------------------------------------------------------------
# Interface language (e.g., en)
SEONAUT_UI_LANGUAGE=en

# Interface color scheme (dark or light)
SEONAUT_UI_THEME=dark
